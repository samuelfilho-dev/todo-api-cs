{
  "AppSettings": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "${ISSUER}",
    "Audience": "${AUDIENCE}"
  },
  "ConnectionStrings": {
    "DefaultConnection": "${DB_CONNECTION_STRING}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
